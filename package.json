{
  "name": "quire",
  "productName": "Quire",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone desktop document reader extracted from DeepSeek Harness",
  "type": "module",
  "main": "src/main/electron-main.cjs",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:dev": "node tools/build.mjs --sourcemap",
    "dev": "node src/devserver/server.js",
    "desktop": "node tools/launch-app.mjs",
    "desktop:electron": "electron .",
    "smoke": "node tools/p0-smoke.mjs",
    "verify": "node --import ./tools/register-css-hook.mjs tools/verify-dom.mjs",
    "test": "node --test tools/unit.test.mjs tools/contract.test.mjs",
    "app:start": "node tools/launch-app.mjs",
    "app:stop": "node tools/launch-app.mjs --stop",
    "verify:app": "node tools/verify-app.mjs",
    "verify:security": "node tools/verify-security.mjs",
    "verify:html": "node tools/verify-html-preview.mjs",
    "verify:render": "node tools/verify-render-strict.mjs",
    "verify:formats": "node tools/verify-formats.mjs",
    "verify:large": "node tools/verify-large-file.mjs",
    "verify:all": "node tools/verify-all.mjs",
    "verify:office": "node tools/verify-office.mjs",
    "verify:package": "node tools/verify-package.mjs",
    "package": "node tools/build.mjs && node tools/package.mjs",
    "package:zip": "node tools/zip-release.mjs",
    "release:outside": "node tools/export-release.mjs",
    "package:all": "node tools/package.mjs && node tools/build-installer.mjs && node tools/zip-release.mjs && node tools/export-release.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-code-language": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "^0.1.7-rc.2",
    "@shikijs/langs": "^4.5.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "immer": "^11.1.21",
    "katex": "^0.19.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "^4.5.0",
    "simple-icons": "^16.35.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "33.4.11",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.1",
    "playwright-chromium": "^1.64.0",
    "vite": "^8.3.4"
  }
}
